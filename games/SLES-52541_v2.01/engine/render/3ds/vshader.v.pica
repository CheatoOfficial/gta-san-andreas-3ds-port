.fvec projection[4]
.constf k(0.99609375, 0.001953125, 0.5, 1.0)
.out outpos position
.out outclr color
.out outtc0 texcoord0.st
.out - texcoord0w outtc0.p
.out outtc1 texcoord1
.alias inpos v0
.alias inclr v1
.alias inuv v2
.alias infog v3
.proc main
 mov r0, inpos
 dp4 outpos.x, projection[0], r0
 dp4 outpos.y, projection[1], r0
 dp4 outpos.z, projection[2], r0
 dp4 outpos.w, projection[3], r0
 mov outclr, inclr
 mov outtc1, inuv
 mul r1.x, k.x, infog.x
 add r1.x, k.y, r1.x
 mul outtc0.x, r1.x, inpos.w
 mul outtc0.y, k.z, inpos.w
 mov outtc0.z, inpos.w
 end
.end
